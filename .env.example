# =============================================
#  Data-Scrapper BaaS — Environment Variables
# =============================================
# Copy this file to .env and fill in your values

# ========================
# Server
# ========================
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
WORKER_CONCURRENCY=3

# ========================
# Database
# ========================
DATABASE_URL=postgresql://datascrapper:datascrapper123@localhost:5432/datascrapper

# ========================
# Redis
# ========================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ========================
# JWT
# ========================
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ========================
# Scraping
# ========================
# Free proxy list (comma-separated: host:port or user:pass@host:port)
PROXY_LIST=
# Set to false during development to see browser
BROWSER_HEADLESS=true
# Max concurrent browser contexts per worker
MAX_CONCURRENT_JOBS=3
# Cache TTL in hours (24 = 24 hours)
CACHE_TTL_HOURS=24

# ========================
# Payment Gateway
# ========================
# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# Tripay (alternative)
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_IS_PRODUCTION=false

# ========================
# Frontend
# ========================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
