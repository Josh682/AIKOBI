FROM node:20

# Install pnpm and Playwright system dependencies
RUN npm install -g pnpm@9.15.0
RUN npx -y playwright install-deps chromium

WORKDIR /app

# Copy workspace manifests + prisma schema first
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY packages/config/package.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY packages/db/prisma ./packages/db/prisma
COPY packages/shared-types/package.json ./packages/shared-types/
COPY apps/worker/package.json ./apps/worker/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Install Chromium browser for Playwright
RUN pnpm --filter @datascrapper/worker exec playwright install chromium

# Generate Prisma client
RUN pnpm --filter @datascrapper/db db:generate

# Copy all source code
COPY packages/ ./packages/
COPY apps/worker/ ./apps/worker/

# Build using turbo
RUN pnpm run build --filter=@datascrapper/worker

CMD ["sh", "-c", "pnpm --filter @datascrapper/db exec prisma db push --schema=packages/db/prisma/schema.prisma && node apps/worker/dist/index.js"]
