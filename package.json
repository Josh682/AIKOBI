{
  "name": "data-scrapper",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@datascrapper/api",
    "dev:worker": "turbo run dev --filter=@datascrapper/worker",
    "dev:web": "turbo run dev --filter=@datascrapper/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "turbo run db:generate --filter=@datascrapper/db",
    "db:migrate": "turbo run db:migrate --filter=@datascrapper/db",
    "db:push": "turbo run db:push --filter=@datascrapper/db",
    "db:seed": "turbo run db:seed --filter=@datascrapper/db",
    "db:studio": "pnpm --filter=@datascrapper/db db:studio",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
